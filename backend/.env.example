# Database Configuration
# Replace 'password' with your actual MySQL root password
# If you don't have a password, use: mysql+pymysql://root:@localhost/blog_platform
DATABASE_URL=mysql+pymysql://root:password@localhost/blog_platform

# JWT Secret Key (change in production)
JWT_SECRET_KEY=dev-secret-key-12345

# OpenAI API Key (leave empty to use mock AI)
OPENAI_API_KEY=

# Flask Environment
FLASK_ENV=development
