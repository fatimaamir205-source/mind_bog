# Database Configuration
DATABASE_URL=mysql+pymysql://root:@localhost/blog_platform
BLOG_DATABASE_URL=mysql+pymysql://root:@localhost/blog_platform

# JWT Secret Key
JWT_SECRET_KEY=your-secret-key-change-in-production

# OpenAI API Key (for content analysis, fact-checking, and content generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Image Generation API Key (for AI image generation)
# Use the same OpenAI key for DALL-E, or a different service like Stability AI
IMAGE_API_KEY=sk-your-image-api-key-here

# Flask Environment
FLASK_ENV=development
